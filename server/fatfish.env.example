# 复制成 fatfish.env 并填好。名字和 Cloudflare Worker 里的变量完全一致。
PORT=8787
MS_KEY=你的ModelScope令牌
GH_TOKEN=你的GitHub令牌
GH_REPO=你的用户名/fatfish-memory
GH_BRANCH=main
MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
ADMIN_PW=你的站长密码
SESSION_SECRET=随便一长串随机字符
TTS_APPID=豆包语音APPID
TTS_TOKEN=豆包语音AccessToken
# 联网搜索（至少配一个）
TAVILY_KEY=
SERPER_KEY=
# 语音识别：这台服务器上没有 Cloudflare 的 AI，用下面两个调用同一个 Whisper（Cloudflare 账号 ID + 有 Workers AI 权限的 API 令牌）
CF_ACCOUNT_ID=
CF_API_TOKEN=
